# Copy to config.json / set in your environment.
# Get/administer keys at your droplet admin endpoints.

# Website Intelligence APIs — served at https://momentumbysamay.online/api/website-intel
WEBSITE_INTEL_BASE=https://momentumbysamay.online/api/website-intel
WEBSITE_INTEL_KEY=your_website_intel_admin_key

# Marketing API Bundle — served at https://momentumbysamay.online/api/marketing
MARKETING_BUNDLE_BASE=https://momentumbysamay.online/api/marketing
MARKETING_BUNDLE_KEY=your_marketing_bundle_admin_key

# Solana USDC treasury wallet (receives payments)
TREASURY_WALLET=F8tmJqiybEpcSbAbWef3XhsknsnW4gxb2gv6K8ZxEfgE

# Privy app (wallet + auth)
PRIVY_APP_ID=your_privy_app_id
